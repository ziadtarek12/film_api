# ── Neo4j ─────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme-strong-password

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-32-char-secret

# ── App ───────────────────────────────────────────────────────
APP_PORT=4000
APP_ENV=production
LIMITER_RPS=100
LIMITER_BURST=200
LIMITER_ENABLED=true
